# Copy to .env (never commit it) or export these in your shell.
GEMINI_API_KEY=your-gemini-api-key
# Optional: read GEMINI_API_KEY from another .env file at startup instead.
# DEMO_ENV_FILE=/path/to/.env
# Optional knobs (defaults shown)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_THINKING_LEVEL=low
# DEMO_SINGLE_MAX_TURNS=30
# DEMO_SPLIT_MAX_TURNS=12
# DEMO_SPLIT_RETRY_TURNS=8
# DEMO_MODE_MAX_USD=0.25
# DEMO_TOOL_OUTPUT_CHARS=4000
# DEMO_PRELOAD_FILES=1
# DEMO_PYTEST_CONCURRENCY=3
# Test only (needs devtools/, never set in production):
# DEMO_FAKE_MODEL=1
# DEMO_LIVE_ENABLED=1
# DEMO_PER_VISITOR_SECONDS=60
# DEMO_MAX_CONCURRENT=2
# DEMO_MAX_RUNS_PER_HOUR=30
# DEMO_MAX_RUNS_PER_DAY=200
